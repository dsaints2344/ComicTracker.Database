# Copy to .env (git-ignored) - docker compose reads it automatically.

# SA password for the local SQL Server container.
# Must meet SQL Server complexity rules; avoid '$' (compose treats it as interpolation).
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Host port for SQL Server (localhost,1434 matches the .envrc connection string)
SQL_HOST_PORT=1434

# grate environment (controls which *.env.<ENV>.sql scripts run)
GRATE_ENVIRONMENT=LOCAL
